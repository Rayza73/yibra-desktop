{
  "name": "yibra-desktop",
  "productName": "Yibra",
  "version": "0.3.5",
  "description": "Yibra desktop client - the squad voice app, with tray, hotkey and auto-updates.",
  "main": "src/main.js",
  "private": true,
  "author": "Rayza73",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --yibra-dev",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "za.co.tuulu.yibra",
    "productName": "Yibra",
    "copyright": "Copyright (c) 2026 Rayza73",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Yibra-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yibra",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Yibra"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rayza73",
        "repo": "yibra-desktop",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rayza73/yibra-desktop.git"
  }
}
